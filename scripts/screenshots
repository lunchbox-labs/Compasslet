#!/usr/bin/env python3
"""Capture every app screen on iPhone simulators.

capture     Build the app once, then run ScreenshotTests on each device and appearance. The
            test shows one screen at a time and asks for a screenshot by writing a request
            file; this script answers with a full simulator screenshot and a done file.
            A screen that scrolls is then scrolled about one screen at a time and each
            further part saved as <name>-part2, -part3 and so on, up to --max-parts.
            A simulator with more than one display, such as iPhone Duo, runs each pass once
            folded and once open, saving the lit display as <name>-outer or <name>-inner.
            --set accessibility captures the simulator part of the App Store accessibility
            evidence instead: fixed devices, text sizes, Bold Text, Increase Contrast,
            Reduce Transparency and Dark Mode, as listed in ACCESSIBILITY_SET.
            --set listing captures the App Store listing screenshots, as listed in
            LISTING_SET.
"""
import argparse
import json
import os
import plistlib
import re
import subprocess
import sys
import tempfile
import threading
import time
from dataclasses import dataclass, replace
from pathlib import Path

ALIASES = ("largest", "smallest")
APPEARANCES = ("light", "dark")
BUNDLE_IDENTIFIER = "dev.lunchbox-labs.carplay-compass"
MANIFEST = "screenshots.json"
MINIMUM_IOS = 27
LAUNCH_SCREEN = "launch-first-frame"
# Parts of one scrolling screen, counting the first. Nine keeps part numbers to one digit, so
# they sort in order, and by default a run captures as many as that allows.
MAX_PARTS_LIMIT = 9
DEFAULT_MAX_PARTS = MAX_PARTS_LIMIT
PART_SUFFIX = re.compile(r"^(.+)-part([2-9])$")


@dataclass(frozen=True)
class CapturePass:
    """One test run on one simulator: the screens to show and the settings to show them with.

    text_variants are applied by the test to each screen (ax3, ax5, either with -bold).
    system_settings are turned on in the simulator first; the test checks the system reports
    them. undecided_location resets location access so the app's permission prompt appears.
    captures_launch saves the app's first frame after a cold launch before the test runs.
    """
    device: str
    appearance: str
    screens: tuple
    text_variants: tuple = ()
    system_settings: tuple = ()
    undecided_location: bool = False
    captures_launch: bool = False
    tag: str = ""


SYSTEM_SETTINGS = {
    "increase-contrast": lambda udid, on: ["xcrun", "simctl", "ui", udid, "increase_contrast",
                                           "enabled" if on else "disabled"],
    "reduce-transparency": lambda udid, on: [
        "xcrun", "simctl", "spawn", udid, "defaults", "write", "com.apple.Accessibility",
        "EnhancedBackgroundContrastEnabled", "-bool", "YES" if on else "NO"],
}

TOUR = ("tour-welcome", "tour-live-activity-button", "tour-live-activity-button-carplay",
        "tour-shortcuts", "tour-shortcuts-carplay")
# The Live Activity button shows only while CarPlay is connected.
COMPASS_WITH_LIVE_ACTIVITY_BUTTON = "compass-live-activity-start"
# The button's tip, shown the first time CarPlay connects after the tour.
LIVE_ACTIVITY_TIP = "compass-live-activity-tip"
APPEARANCE_PAGES = ("settings-appearance", "settings-appearance-global",
                    "settings-appearance-iphone", "settings-appearance-live-activity",
                    "settings-appearance-minor-ticks", "settings-appearance-cardinal-labels",
                    "settings-appearance-rotation", "settings-appearance-reduce-motion")
LARGER_TEXT = (COMPASS_WITH_LIVE_ACTIVITY_BUTTON, LIVE_ACTIVITY_TIP, *TOUR, "settings",
               "settings-bottom", *APPEARANCE_PAGES, "compass-location-denied")
CONTRAST = (COMPASS_WITH_LIVE_ACTIVITY_BUTTON, LIVE_ACTIVITY_TIP, "compass-settings-sheet",
            "settings")
DARK_INTERFACE = (*TOUR, "compass", COMPASS_WITH_LIVE_ACTIVITY_BUTTON, LIVE_ACTIVITY_TIP,
                  "compass-location-denied", "compass-settings-sheet", "settings",
                  "settings-bottom", "settings-diagnostics-export", "live-activity")

SMALL_PHONE = "iPhone SE (3rd generation)"
SECOND_SMALL_PHONE = "iPhone 13 mini"
CURRENT_PHONE = "iPhone 17"
ACCESSIBILITY_SET = (
    CapturePass(SMALL_PHONE, "light", LARGER_TEXT,
                text_variants=("ax3", "ax3-bold", "ax5", "ax5-bold")),
    CapturePass(SECOND_SMALL_PHONE, "light",
                (COMPASS_WITH_LIVE_ACTIVITY_BUTTON, *TOUR, "settings", "settings-bottom",
                 "compass-location-denied", "live-activity", "live-activity-elapsed-time",
                 "live-activity-status"), text_variants=("ax5-bold",)),
    CapturePass(CURRENT_PHONE, "light", ("live-activity", "live-activity-status"),
                text_variants=("ax5",)),
    CapturePass(CURRENT_PHONE, "light", CONTRAST),
    *(CapturePass(CURRENT_PHONE, appearance, CONTRAST, system_settings=(setting,), tag=setting)
      for setting in SYSTEM_SETTINGS for appearance in APPEARANCES),
    CapturePass(CURRENT_PHONE, "dark", DARK_INTERFACE, captures_launch=True),
    # Last on its simulator: the prompt stays up until the run ends.
    CapturePass(CURRENT_PHONE, "dark", ("compass-location-prompt",), undecided_location=True),
)
# Apple's screenshot specifications list one required iPhone size, iPhone with Dynamic Island
# (medium display), which iPhone 17 is, and require iPhone Duo's displays from April 2027 for apps
# built with the iOS 27.1 SDK (#305). The app is iPhone only (#309) and ships without Apple Watch
# (#304) screenshots for now. The documented file names use these names.
LISTING_PHONE = "iPhone 17"
LISTING_DUO = "iPhone Duo"
LISTING_SET = tuple(CapturePass(device, appearance, ("compass",))
                    for device in (LISTING_PHONE, LISTING_DUO) for appearance in APPEARANCES)
SETS = {"accessibility": ACCESSIBILITY_SET, "listing": LISTING_SET}


def split_list(value):
    return [item.strip() for item in value.split(",") if item.strip()]


def run(arguments, **options):
    print("+ " + " ".join(arguments), flush=True)
    return subprocess.run(arguments, check=True, text=True, **options)


def screen_points(device_type):
    """The primary display's size in points from the device type's capabilities, or None."""
    capabilities = Path(device_type.get("bundlePath", "")) / "Contents/Resources/capabilities.plist"
    try:
        with capabilities.open("rb") as file:
            display = plistlib.load(file)["capabilities"]["displays"][0]
        return display["width"] / display["scale"], display["height"] / display["scale"]
    except (OSError, KeyError, IndexError, TypeError, ZeroDivisionError,
            plistlib.InvalidFileException):
        return None


def available_iphones(devices_by_runtime, device_types):
    """Available iPhones on iOS MINIMUM_IOS or later, each name once on its newest runtime."""
    types = {item["identifier"]: item for item in device_types}
    phones = {}
    for runtime, devices in sorted(devices_by_runtime.items(), key=runtime_order, reverse=True):
        version = runtime_version(runtime)
        if version is None or version[0] < MINIMUM_IOS:
            continue
        for device in devices:
            if (not device.get("isAvailable") or not device["name"].startswith("iPhone")
                    or device["name"] in phones):
                continue
            device_type = types.get(device.get("deviceTypeIdentifier"), {})
            phones[device["name"]] = {"udid": device["udid"], "name": device["name"],
                                      "runtime": runtime, "points": screen_points(device_type)}
    return list(phones.values())


def runtime_version(runtime):
    match = re.search(r"\.iOS-(\d+)-(\d+)", runtime)
    return (int(match.group(1)), int(match.group(2))) if match else None


def runtime_order(item):
    return runtime_version(item[0]) or (0, 0)


def alias_order(phone):
    """Largest has the most screen area; smallest is the narrowest, then the shortest."""
    width, height = phone["points"]
    return width * height, width, height


def select_devices(requested, phones):
    """Resolve each requested alias or exact simulator name to a device and a file label."""
    selected = []
    for request in requested:
        if request in ALIASES:
            sized = [phone for phone in phones if phone["points"]]
            if not sized:
                raise SystemExit("No simulator reports a screen size for " + request)
            if request == "largest":
                phone = max(sized, key=alias_order)
            else:
                phone = min(sized, key=lambda phone: alias_order(phone)[1:])
            label = request
        else:
            matches = [phone for phone in phones if phone["name"] == request]
            if not matches:
                names = ", ".join(sorted(phone["name"] for phone in phones))
                raise SystemExit("No available simulator named " + request + "; found " + names)
            phone = matches[0]
            label = device_label(request)
        if any(item["udid"] == phone["udid"] for item in selected):
            continue
        selected.append(dict(phone, label=label))
    return selected


def image_name(label, appearance, screen, tag="", display=None):
    parts = (label, appearance, tag, screen, display.name if display else "")
    return "-".join(part for part in parts if part) + ".png"


@dataclass(frozen=True)
class Display:
    """One display of a simulator with several: its name in file names, its simctl id, and the
    hinge angle in degrees that shows apps on it."""
    name: str
    identifier: str
    hinge: int


# simctl lists the displays it could capture, as "--display=3  LCD-1 (primary-1) 2007x2853".
DISPLAY_CHOICE = re.compile(r"^\s*--display=(\S+)\s.*?(\d+)x(\d+)\s*$", re.MULTILINE)
HINGE_SOURCE = Path(__file__).resolve().with_name("simulator-hinge.m")
# How long a display may take to light after the hinge moves, how long the move between
# displays then takes to finish, and how dark a lit display never is.
DISPLAY_WAIT_SECONDS = 20
DISPLAY_SETTLE_SECONDS = 2
DARK_LEVEL = 16
# The hinge tool waits on the simulator over XPC, so it gets a deadline of its own.
HINGE_TIMEOUT_SECONDS = 30
# The hinge angle of each simulator: 0 once booted, as it boots closed, and missing after a move
# that failed, when the angle isn't known.
HINGE_ANGLES = {}


def displays_from(output):
    """The outer and inner displays simctl lists when it can't choose between them: closed,
    the smallest shows apps, and open flat, the largest. Empty when it lists fewer than two."""
    choices = sorted(DISPLAY_CHOICE.findall(output),
                     key=lambda choice: int(choice[1]) * int(choice[2]))
    if len(choices) < 2:
        return []
    return [Display("outer", choices[0][0], 0), Display("inner", choices[-1][0], 180)]


def find_displays(udid):
    """The displays of a simulator with more than one, or empty for a single display."""
    with tempfile.TemporaryDirectory() as directory:
        result = subprocess.run(["xcrun", "simctl", "io", udid, "screenshot",
                                 str(Path(directory) / "probe.png")], check=False,
                                capture_output=True, text=True)
    if result.returncode == 0:
        return []
    return displays_from((result.stdout or "") + (result.stderr or ""))


def take_screenshot(udid, path, display=None):
    """Saves the simulator's screen, or one display of a simulator with several, at path."""
    arguments = ["xcrun", "simctl", "io", udid, "screenshot"]
    if display:
        arguments.append("--display=" + display.identifier)
    result = subprocess.run(arguments + [str(path)], check=False)
    return result.returncode == 0 and path.exists()


def is_dark_bitmap(data):
    """Whether an uncompressed 24- or 32-bit BMP has no colour brighter than DARK_LEVEL,
    ignoring alpha. Only the pixel array counts, not a colour profile or anything after it.
    Raises ValueError for a bitmap it can't read."""
    def number(start, size, signed=False):
        return int.from_bytes(data[start:start + size], "little", signed=signed)

    if data[:2] != b"BM" or number(14, 4) < 40:
        raise ValueError("not a Windows bitmap")
    offset, width, bits = number(10, 4), number(18, 4, True), number(28, 2)
    # Bottom-up bitmaps have a positive height and top-down ones a negative height.
    rows = abs(number(22, 4, True))
    if bits not in (24, 32) or number(30, 4) not in (0, 3) or width <= 0 or rows == 0:
        raise ValueError("unsupported bitmap")
    channels = bits // 8
    stride = (width * bits + 31) // 32 * 4
    if offset + rows * stride > len(data):
        raise ValueError("truncated bitmap")
    brightest = 0
    for row in range(rows):
        start = offset + row * stride
        pixels = data[start:start + width * channels]
        if channels == 4:
            pixels = bytes(value for index, value in enumerate(pixels) if index % 4 != 3)
        brightest = max(brightest, max(pixels))
    return brightest < DARK_LEVEL


def display_state(udid, display):
    """Whether the display is lit, dark or unjudged, from a small copy of a screenshot, or
    failed when no screenshot could be taken."""
    with tempfile.TemporaryDirectory() as directory:
        image, bitmap = Path(directory) / "probe.png", Path(directory) / "probe.bmp"
        if not take_screenshot(udid, image, display):
            print("Couldn't take a screenshot of the " + display.name + " display",
                  file=sys.stderr)
            return "failed"
        result = subprocess.run(["sips", "-s", "format", "bmp", "--resampleHeightWidth", "32",
                                 "32", str(image), "--out", str(bitmap)], check=False,
                                capture_output=True)
        try:
            if result.returncode == 0 and bitmap.exists():
                return "dark" if is_dark_bitmap(bitmap.read_bytes()) else "lit"
        except ValueError:
            pass
        print("Couldn't check whether the " + display.name + " display is lit",
              file=sys.stderr)
        return "unjudged"


def display_is_lit(udid, display):
    """Whether the display shows anything. An image that can't be judged counts as lit, so a
    missing tool doesn't stop the capture."""
    return display_state(udid, display) in ("lit", "unjudged")


def build_hinge_tool(directory):
    """Compiles simulator-hinge.m into directory; returns the tool, or None if it won't build."""
    tool = Path(directory) / "simulator-hinge"
    result = subprocess.run(["xcrun", "clang", "-fobjc-arc", "-framework", "Foundation", "-o",
                             str(tool), str(HINGE_SOURCE)], check=False)
    return tool if result.returncode == 0 else None


def move_hinge(hinge_tool, udid, degrees):
    """Sets the simulator's hinge angle; returns whether the tool finished in time and
    succeeded. The tool talks to the Xcode in DEVELOPER_DIR, so the selected one is passed when
    it isn't set."""
    environment = dict(os.environ)
    if not environment.get("DEVELOPER_DIR"):
        selected = subprocess.run(["xcode-select", "-p"], check=False, capture_output=True,
                                  text=True)
        environment["DEVELOPER_DIR"] = (selected.stdout or "").strip()
    HINGE_ANGLES.pop(udid, None)
    print("+ simulator-hinge " + udid + " " + str(degrees), flush=True)
    try:
        result = subprocess.run([str(hinge_tool), udid, str(degrees)], check=False,
                                env=environment, timeout=HINGE_TIMEOUT_SECONDS)
    except subprocess.TimeoutExpired:
        print("The hinge tool didn't finish within " + str(HINGE_TIMEOUT_SECONDS) + " seconds",
              file=sys.stderr)
        return False
    if result.returncode != 0:
        return False
    HINGE_ANGLES[udid] = degrees
    return True


def show_display(udid, display, hinge_tool):
    """Folds or opens the simulator so apps show on display; returns whether the display lit.
    Without the hinge tool the simulator stays closed, as it boots. Before opening, a display
    that should be dark while closed must read dark, or its later reading can't be trusted."""
    if display.hinge != 0:
        if HINGE_ANGLES.get(udid) != 0:
            print("The hinge angle isn't known after a failed move, so the " + display.name
                  + " display can't be checked dark first", file=sys.stderr)
            return False
        if display_state(udid, display) != "dark":
            print("The dark check isn't working: the " + display.name + " display didn't read "
                  "dark with the simulator closed, so it can't tell when it lights",
                  file=sys.stderr)
            return False
    if hinge_tool:
        if not move_hinge(hinge_tool, udid, display.hinge):
            return False
    elif display.hinge != 0:
        print("The hinge tool didn't build, so the simulator can't be opened", file=sys.stderr)
        return False
    deadline = time.monotonic() + DISPLAY_WAIT_SECONDS
    while (state := display_state(udid, display)) not in ("lit", "unjudged"):
        if time.monotonic() >= deadline:
            if state == "dark":
                print("The " + display.name + " display stayed dark after the hinge moved to "
                      + str(display.hinge) + " degrees", file=sys.stderr)
            else:
                print("No screenshot of the " + display.name + " display could be taken to "
                      "check it lit", file=sys.stderr)
            return False
        time.sleep(2)
    time.sleep(DISPLAY_SETTLE_SECONDS)
    return True


def device_label(name):
    return re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")


def creatable_iphones(runtimes):
    """iPhone device types each iOS MINIMUM_IOS+ runtime supports, newest runtime first."""
    creatable = {}
    for runtime in sorted(runtimes, key=lambda runtime: runtime_version(runtime["identifier"])
                          or (0, 0), reverse=True):
        version = runtime_version(runtime["identifier"])
        if not runtime.get("isAvailable") or version is None or version[0] < MINIMUM_IOS:
            continue
        for device_type in runtime.get("supportedDeviceTypes", []):
            if device_type["name"].startswith("iPhone"):
                creatable.setdefault(device_type["name"], (device_type["identifier"],
                                                           runtime["identifier"]))
    return creatable


def passes_for(set_name, screen_filter):
    """The set's passes, each narrowed to the screens the filter's prefixes match."""
    prefixes = split_list(screen_filter)

    def matches_filter(screen):
        return not prefixes or any(screen.startswith(prefix) for prefix in prefixes)

    narrowed = []
    for capture_pass in SETS[set_name]:
        screens = tuple(screen for screen in capture_pass.screens if matches_filter(screen))
        launch = capture_pass.captures_launch and matches_filter(LAUNCH_SCREEN)
        if screens or launch:
            narrowed.append(replace(capture_pass, screens=screens, captures_launch=launch))
    if not narrowed:
        raise SystemExit("No screen in the " + set_name + " set starts with " + screen_filter)
    return narrowed


def split_part(request):
    """The screen request and part a capture names, as the test joins them: request-partN.
    The first part keeps the screen's own name."""
    match = PART_SUFFIX.match(request)
    return (match.group(1), int(match.group(2))) if match else (request, 1)


def number_first_parts(entries):
    """Marks the first capture of each screen that has later parts as part 1."""
    def key(entry):
        return entry["screen"], entry.get("text_variant")

    scrolled = {key(entry) for entry in entries if "part" in entry}
    return [dict(entry, part=1) if "part" not in entry and key(entry) in scrolled else entry
            for entry in entries]


def max_parts(value):
    """Parses --max-parts: a whole number from 1, only the top of each screen, to the limit."""
    try:
        parts = int(value)
    except ValueError:
        parts = 0
    if not 1 <= parts <= MAX_PARTS_LIMIT:
        raise argparse.ArgumentTypeError("use a whole number from 1 to " + str(MAX_PARTS_LIMIT))
    return parts


def split_text_variant(request, text_variants):
    """The screen and text variant a request names, as the test joins them: screen-variant."""
    for variant in sorted(text_variants, key=len, reverse=True):
        if request.endswith("-" + variant):
            return request[:-len(variant) - 1], variant
    return request, "standard"


class ScreenshotResponder(threading.Thread):
    """Takes a simulator screenshot for each request file the test writes."""

    def __init__(self, udid, requests, output, label, appearance, tag="", display=None):
        super().__init__(daemon=True)
        self.udid, self.requests, self.output = udid, requests, output
        self.label, self.appearance, self.tag = label, appearance, tag
        self.display = display
        self.captured = []
        self.failed = []
        self.stopping = threading.Event()

    def run(self):
        while not self.stopping.is_set():
            for request in sorted(self.requests.glob("*.request")):
                screen = request.stem
                request.unlink()
                name = image_name(self.label, self.appearance, screen, self.tag, self.display)
                if take_screenshot(self.udid, self.output / name, self.display):
                    self.captured.append({"screen": screen, "file": name})
                else:
                    self.failed.append(name)
                (self.requests / (screen + ".done")).touch()
            time.sleep(0.1)

    def stop(self):
        self.stopping.set()
        self.join()


def simctl_json(*arguments):
    return json.loads(run(["xcrun", "simctl", "list", "--json", *arguments],
                          capture_output=True).stdout)


def quietly(arguments):
    """Runs a cleanup command whose failure, such as nothing to terminate, doesn't matter."""
    subprocess.run(arguments, check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def find_devices(names, created):
    """Available simulators for exact names or aliases. A named iPhone that is missing but
    supported by an iOS MINIMUM_IOS+ runtime is created and its id added to created, so the
    caller can delete it afterwards, even when this raises."""
    types = simctl_json("devicetypes")["devicetypes"]
    phones = available_iphones(simctl_json("devices", "available")["devices"], types)
    missing = [name for name in names
               if name not in ALIASES and name not in {phone["name"] for phone in phones}]
    if missing:
        creatable = creatable_iphones(simctl_json("runtimes")["runtimes"])
        unknown = [name for name in missing if name not in creatable]
        if unknown:
            found = ", ".join(sorted(phone["name"] for phone in phones))
            raise SystemExit("No available simulator named " + ", ".join(unknown) + "; found "
                             + found + "; iOS " + str(MINIMUM_IOS) + " also supports "
                             + ", ".join(sorted(creatable)))
        for name in missing:
            type_identifier, runtime = creatable[name]
            created.append(run(["xcrun", "simctl", "create", name, type_identifier, runtime],
                               capture_output=True).stdout.strip())
        phones = available_iphones(simctl_json("devices", "available")["devices"], types)
    return select_devices(names, phones)


def set_system_setting(udid, setting, on):
    run(SYSTEM_SETTINGS[setting](udid, on))


def boot(udid):
    subprocess.run(["xcrun", "simctl", "boot", udid], check=False)
    run(["xcrun", "simctl", "bootstatus", udid, "-b"])
    run(["xcrun", "simctl", "status_bar", udid, "override", "--time", "9:41",
         "--dataNetwork", "wifi", "--wifiMode", "active", "--wifiBars", "3",
         "--cellularMode", "active", "--cellularBars", "4",
         "--batteryState", "charged", "--batteryLevel", "100"])


def prepare_device(udid, app):
    try:
        boot(udid)
    except subprocess.CalledProcessError:
        # Only when starting fails, any iPhone gets one more boot: the iPhone Duo runtime has
        # been seen to report itself booted and then shut down before it took the status bar.
        print("The simulator stopped while starting, so it's booted again", file=sys.stderr)
        quietly(["xcrun", "simctl", "shutdown", udid])
        boot(udid)
    # Granting location first keeps the host app's permission prompt off the screenshots.
    run(["xcrun", "simctl", "install", udid, str(app)])
    run(["xcrun", "simctl", "privacy", udid, "grant", "location", BUNDLE_IDENTIFIER])
    # The test fails if either setting is on unasked, so a reused simulator starts clean.
    for setting in SYSTEM_SETTINGS:
        set_system_setting(udid, setting, False)


def capture_launch(device, capture_pass, output, display=None):
    """Saves the launch screen as a cold launch shows it. The app is held before its first line
    of code runs, so the system's generated launch screen stays up until the capture."""
    udid = device["udid"]
    quietly(["xcrun", "simctl", "terminate", udid, BUNDLE_IDENTIFIER])
    name = image_name(device["label"], capture_pass.appearance, LAUNCH_SCREEN, capture_pass.tag,
                      display)
    try:
        run(["xcrun", "simctl", "launch", "--wait-for-debugger", udid, BUNDLE_IDENTIFIER],
            capture_output=True)
        # Long enough for the launch animation to finish.
        time.sleep(2)
        saved = take_screenshot(udid, output / name, display)
    finally:
        quietly(["xcrun", "simctl", "terminate", udid, BUNDLE_IDENTIFIER])
    if saved:
        return {"screen": LAUNCH_SCREEN, "file": name}
    print("No screenshot was saved for " + name, file=sys.stderr)
    return None


def run_pass(xcodebuild, device, capture_pass, output, screen_filter, parts, display=None,
             hinge_tool=None):
    """Runs ScreenshotTests once, with display showing the app on a simulator that has several;
    returns the captured entries and whether anything failed."""
    udid = device["udid"]
    captured, failed = [], False
    try:
        run(["xcrun", "simctl", "ui", udid, "appearance", capture_pass.appearance])
        for setting in capture_pass.system_settings:
            set_system_setting(udid, setting, True)
        if capture_pass.undecided_location:
            run(["xcrun", "simctl", "privacy", udid, "reset", "location", BUNDLE_IDENTIFIER])
        shown = display is None or show_display(udid, display, hinge_tool)
        if not shown:
            print("Nothing was captured on the " + display.name + " display of "
                  + device["name"] + " in " + capture_pass.appearance, file=sys.stderr)
            failed = True
        if shown and capture_pass.captures_launch:
            launch = capture_launch(device, capture_pass, output, display)
            captured += [launch] if launch else []
            failed = launch is None
        if shown and (capture_pass.screens or not capture_pass.captures_launch):
            with tempfile.TemporaryDirectory() as requests:
                responder = ScreenshotResponder(udid, Path(requests), output, device["label"],
                                                capture_pass.appearance, capture_pass.tag,
                                                display)
                responder.start()
                environment = dict(
                    os.environ, TEST_RUNNER_SCREENSHOT_DIRECTORY=requests,
                    TEST_RUNNER_SCREENSHOT_APPEARANCE=capture_pass.appearance,
                    TEST_RUNNER_SCREENSHOT_FILTER=screen_filter,
                    TEST_RUNNER_SCREENSHOT_SCREENS=",".join(capture_pass.screens),
                    TEST_RUNNER_SCREENSHOT_MAX_PARTS=str(parts),
                    TEST_RUNNER_SCREENSHOT_TEXT_VARIANTS=",".join(capture_pass.text_variants),
                    TEST_RUNNER_SCREENSHOT_SYSTEM_SETTINGS=",".join(capture_pass.system_settings))
                try:
                    result = subprocess.run(
                        xcodebuild + ["-destination", "platform=iOS Simulator,id=" + udid,
                                      "-only-testing:CompassTests/ScreenshotTests",
                                      "test-without-building"], env=environment, check=False)
                finally:
                    responder.stop()
            failed = failed or result.returncode != 0 or bool(responder.failed)
            for name in responder.failed:
                print("No screenshot was saved for " + name, file=sys.stderr)
            screens = []
            for entry in responder.captured:
                screen, part = split_part(entry["screen"])
                entry = dict(entry, screen=screen)
                if part > 1:
                    entry["part"] = part
                if capture_pass.text_variants:
                    screen, variant = split_text_variant(screen, capture_pass.text_variants)
                    entry = dict(entry, screen=screen, text_variant=variant)
                screens.append(entry)
            captured += number_first_parts(screens)
    finally:
        for setting in capture_pass.system_settings:
            set_system_setting(udid, setting, False)
        if capture_pass.undecided_location:
            quietly(["xcrun", "simctl", "terminate", udid, BUNDLE_IDENTIFIER])
            run(["xcrun", "simctl", "privacy", udid, "grant", "location", BUNDLE_IDENTIFIER])
    details = {"device": device["name"], "runtime": device["runtime"], "label": device["label"],
               "appearance": capture_pass.appearance,
               "system_settings": list(capture_pass.system_settings)}
    if capture_pass.tag:
        details["tag"] = capture_pass.tag
    if display:
        details["display"] = display.name
    # A failed pass may still have saved images, which can't be trusted to show its settings.
    if failed:
        details["pass_failed"] = True
    return [dict(entry, **details) for entry in captured], failed


def capture(arguments):
    output = Path(arguments.output).resolve()
    output.mkdir(parents=True, exist_ok=True)
    if arguments.set:
        if arguments.devices is not None or arguments.appearances is not None:
            raise SystemExit("--set chooses its own devices and appearances; leave out "
                             "--devices and --appearances")
        passes = passes_for(arguments.set, arguments.filter)
        # The set lists exact screens; the filter has already narrowed them.
        screen_filter = ""
        requested = list(dict.fromkeys(capture_pass.device for capture_pass in passes))
    else:
        appearances = split_list(arguments.appearances or "light,dark")
        for appearance in appearances:
            if appearance not in APPEARANCES:
                raise SystemExit("Unknown appearance " + appearance + "; use light or dark")
        requested = split_list(arguments.devices or "largest,smallest")
        passes = None
        screen_filter = arguments.filter
    created = []
    manifest = []
    failed = False
    try:
        devices = find_devices(requested, created)
        if not devices:
            raise SystemExit("No devices requested")
        derived_data = Path(arguments.derived_data).resolve()
        xcodebuild = ["bash", "scripts/simulator-xcodebuild", "-project", "Compass.xcodeproj",
                      "-scheme", "Compass", "-derivedDataPath", str(derived_data),
                      "CODE_SIGNING_ALLOWED=NO"]
        # Build once before any simulator boots, so a boot never competes with the compile.
        run(xcodebuild + ["-destination", "generic/platform=iOS Simulator", "build-for-testing"])
        app = derived_data / "Build/Products/Debug-iphonesimulator/Compass.app"
        hinge_tool = None
        for device in devices:
            if passes is None:
                device_passes = [CapturePass(device["name"], appearance, ())
                                 for appearance in appearances]
            else:
                device_passes = [capture_pass for capture_pass in passes
                                 if capture_pass.device == device["name"]]
            prepare_device(device["udid"], app)
            HINGE_ANGLES[device["udid"]] = 0
            displays = find_displays(device["udid"])
            if displays and hinge_tool is None:
                hinge_tool = build_hinge_tool(derived_data)
            try:
                for capture_pass in device_passes:
                    for display in displays or [None]:
                        entries, pass_failed = run_pass(xcodebuild, device, capture_pass,
                                                        output, screen_filter,
                                                        arguments.max_parts, display, hinge_tool)
                        manifest += entries
                        failed = failed or pass_failed
            finally:
                if displays and hinge_tool and not move_hinge(hinge_tool, device["udid"], 0):
                    print("Couldn't close the simulator before shutting it down",
                          file=sys.stderr)
                quietly(["xcrun", "simctl", "shutdown", device["udid"]])
    finally:
        (output / MANIFEST).write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")
        for udid in created:
            print("+ xcrun simctl delete " + udid, flush=True)
            if subprocess.run(["xcrun", "simctl", "delete", udid], check=False).returncode != 0:
                print("Couldn't delete the simulator created as " + udid, file=sys.stderr)
    print("Captured " + str(len(manifest)) + " screenshots in " + str(output))
    if failed or not manifest:
        raise SystemExit("The screenshot test failed, a screenshot is missing, or nothing was "
                         "captured")


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    commands = parser.add_subparsers(dest="command", required=True)
    capture_parser = commands.add_parser("capture")
    capture_parser.add_argument("--set", choices=sorted(SETS),
                                help="capture a predefined set of devices, settings and screens "
                                     "instead of every screen")
    capture_parser.add_argument("--devices",
                                help="aliases (largest, smallest) or exact simulator names, "
                                     "default largest,smallest; a named iPhone that iOS 27 "
                                     "supports but isn't set up is created and then deleted")
    capture_parser.add_argument("--appearances", help="light, dark or both; default light,dark")
    capture_parser.add_argument("--filter", default="",
                                help="comma-separated screen name prefixes; empty for all")
    capture_parser.add_argument("--max-parts", type=max_parts, default=DEFAULT_MAX_PARTS,
                                help="most captures of each screen that scrolls, counting the "
                                     "first, from 1 (only the top) to "
                                     + str(MAX_PARTS_LIMIT) + "; default "
                                     + str(DEFAULT_MAX_PARTS))
    capture_parser.add_argument("--output", default=".build/screenshots")
    capture_parser.add_argument("--derived-data", default=".build/xcode")
    capture_parser.set_defaults(handler=capture)
    arguments = parser.parse_args(argv)
    arguments.handler(arguments)


if __name__ == "__main__":
    main()
