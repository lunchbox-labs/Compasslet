#!/usr/bin/env bash
# Usage: bash scripts/test-ios [xcodebuild test options...]
# Options, such as -test-iterations 20 -run-tests-until-failure, are passed to xcodebuild's
# test-without-building run.
# ${@+"$@"} keeps an empty option list working under set -u in macOS's bash 3.2.
set -euo pipefail
# Pick an installed, available iOS 27+ iPhone; never silently test an older platform.
destination="$(xcrun simctl list devices available --json | python3 -c '
import json, re, sys
payload = json.load(sys.stdin)
for runtime, devices in sorted(payload["devices"].items(), reverse=True):
    match = re.search(r"\.iOS-(\d+)-", runtime)
    if not match or int(match.group(1)) < 27:
        continue
    for device in devices:
        if device.get("isAvailable") and device["name"].startswith("iPhone"):
            print(device["udid"])
            sys.exit(0)
sys.exit("No available iOS 27+ iPhone simulator")
')"
mkdir -p .build
result_directory="$(mktemp -d .build/test-results.XXXXXX)"
# Boot the device now, in the background, so the boot overlaps the compile instead of
# following it. bootstatus -b boots a shut-down device and returns once it is ready, or at
# once when it is already booted. Its output goes to a log, shown only if the boot fails.
boot_log="$result_directory/simulator-boot.log"
xcrun simctl bootstatus "$destination" -b >"$boot_log" 2>&1 &
boot=$!
# A failed build leaves nothing waiting on the boot, so stop watching it on any exit.
trap 'kill "$boot" 2>/dev/null || true' EXIT
xcodebuild_arguments=(-project Compass.xcodeproj -scheme Compass
  -destination "platform=iOS Simulator,id=$destination" -derivedDataPath .build/xcode
  CODE_SIGNING_ALLOWED=NO)
# Exclude unused simulator slices on ARM hosts, when building and testing the app.
bash scripts/simulator-xcodebuild "${xcodebuild_arguments[@]}" build-for-testing
if ! wait "$boot"; then
  cat "$boot_log" >&2
  echo "The simulator $destination did not boot" >&2
  exit 1
fi
trap - EXIT
bash scripts/simulator-xcodebuild "${xcodebuild_arguments[@]}" \
  -resultBundlePath "$result_directory/CompassTests.xcresult" ${@+"$@"} test-without-building
