#!/usr/bin/env bash
set -euo pipefail
# For simulator builds only: generic destinations ignore ONLY_ACTIVE_ARCH.
# Use a plain CLI assignment; SDK-conditional keys are not parsed by xcodebuild.
if [[ "$(uname -m)" == arm64 ]]; then
  exec xcodebuild "$@" EXCLUDED_ARCHS=x86_64
fi
exec xcodebuild "$@"
