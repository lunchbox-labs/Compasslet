#!/usr/bin/env python3
"""Let CoreSimulator finish mounting runtimes before Xcode mounts Metal."""
import json
import os
import subprocess
import sys
import time

# https://github.com/actions/runner-images/issues/14946#issuecomment-6486239367
# Do not remove the unusable duplicate: wait for the usable mounts instead.
deadline = time.monotonic() + 120
while time.monotonic() < deadline:
    try:
        result = subprocess.run(
            ["xcrun", "simctl", "runtime", "list", "-j"],
            check=True, capture_output=True, text=True,
            timeout=min(30, max(1, deadline - time.monotonic())),
        )
        runtimes = json.loads(result.stdout)
        print(json.dumps(runtimes, sort_keys=True), flush=True)
        usable = [runtime for runtime in runtimes.values()
                  if runtime.get("state") != "Unusable"]
        if usable and all(runtime.get("state") == "Ready"
                          and os.path.ismount(runtime.get("mountPath") or "")
                          for runtime in usable):
            print("Simulator runtimes are ready and mounted", flush=True)
            sys.exit(0)
    except (subprocess.SubprocessError, ValueError) as error:
        print("Runtime readiness probe failed: " + str(error), flush=True)
    time.sleep(min(2, max(0, deadline - time.monotonic())))
sys.exit("Simulator runtimes did not become ready and mounted within 120 seconds")
