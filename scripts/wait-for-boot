#!/usr/bin/env python3
"""Boot simulators one at a time and fail only when a boot stops progressing."""
import argparse
import re
import select
import subprocess
import sys
import time

# Each bootstatus line carries a wall-clock stamp and elapsed counters. Strip them so
# that identical phases compare equal and only a phase change counts as progress.
VOLATILE = re.compile(r"^\[[^\]]*\]\s*|,?\s*Elapsed[^.\n]*\.?|Migration Elapsed:\S+")


def normalize(line):
    return VOLATILE.sub("", line).strip()


def wait_for_boot(udid, stall_seconds, deadline_seconds, command=None):
    """Return once ``simctl bootstatus`` exits; raise RuntimeError when it stalls or fails."""
    command = command or ["xcrun", "simctl", "bootstatus", udid, "-b"]
    print("Waiting for simulator boot: " + udid, flush=True)
    started = time.monotonic()
    with subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                          text=True, bufsize=1) as process:
        try:
            last_progress = started
            previous = None
            while True:
                now = time.monotonic()
                if now - started > deadline_seconds:
                    raise RuntimeError("Simulator boot did not finish within "
                                       + str(deadline_seconds) + " seconds: " + udid)
                if now - last_progress > stall_seconds:
                    raise RuntimeError("Simulator boot made no progress for "
                                       + str(stall_seconds) + " seconds: " + udid)
                ready, _, _ = select.select([process.stdout], [], [], 1)
                if not ready:
                    if process.poll() is not None:
                        break
                    continue
                line = process.stdout.readline()
                if not line:
                    break
                sys.stdout.write(line)
                sys.stdout.flush()
                phase = normalize(line)
                if phase and phase != previous:
                    previous = phase
                    last_progress = time.monotonic()
            status = process.wait()
            if status:
                raise RuntimeError("Simulator boot failed with status " + str(status) + ": " + udid)
        finally:
            if process.poll() is None:
                process.kill()


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("udids", nargs="+", help="simulator UDIDs to boot in order")
    parser.add_argument("--stall-seconds", type=float, default=300,
                        help="fail when bootstatus reports no new phase for this long")
    parser.add_argument("--deadline-seconds", type=float, default=540,
                        help="fail when one boot takes longer than this in total")
    arguments = parser.parse_args(argv)
    try:
        for udid in arguments.udids:
            wait_for_boot(udid, arguments.stall_seconds, arguments.deadline_seconds)
    except RuntimeError as error:
        sys.exit(str(error))


if __name__ == "__main__":
    main()
